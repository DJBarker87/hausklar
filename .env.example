# Safe local-development defaults. Copy to .env and generate your own secret.
APP_ENV=development
DATABASE_PATH=data/hausklar.db
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:8001
WEB_APP_URL=http://localhost:8001
ALLOW_PUBLIC_REGISTRATION=false
SCHEDULER_ENABLED=false

# Optional integrations are disabled when these values are blank/false.
FINANCE_AI_PROVIDER=off
HERMES_BRIDGE_URL=
HERMES_BRIDGE_TOKEN=
STRAVA_INTEGRATION_ENABLED=false
WITHINGS_INTEGRATION_ENABLED=false
LEGACY_HEALTH_INTEGRATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=
HA_TOKEN_ENCRYPTION_KEY=
HA_ALLOWED_ORIGINS=
HA_SAFE_ENTITY_IDS=
WEB_PUSH_VAPID_PRIVATE_KEY=
APNS_KEY_PATH=
ENABLE_BANKING_APPLICATION_ID=
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
